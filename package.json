{
  "name": "obix-core-oop",
  "version": "0.5.0",
  "description": "OBIX OOP projection — a generated class with private state/props, frozen props, read-only external state, and generated action methods that all delegate to obix-core-ir applyAction. Depends on obix-core-spec and obix-core-ir.",
  "license": "MIT",
  "author": "OBINexus Computing — Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "test",
    "CHANGELOG.md",
    "PROVENANCE.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "obix-core-ir": "0.5.0",
    "obix-core-spec": "0.5.0"
  },
  "devDependencies": {
    "obix-fixture-timer": "0.5.0"
  },
  "keywords": [
    "obix"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-core-oop.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-core-oop/issues"
  },
  "homepage": "https://github.com/obinexus/obix-core-oop#readme"
}
